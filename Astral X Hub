task.spawn(function()
    while true do
        -- SÓ FUNCIONA SE VOCÊ FOR O ASSASSINO
        if player.Name == Murder and player.Character then
            local minhaPos = HRP().Position

            -- ✅ AURA DE MATAR
            if KillAuraAtivo then
                for _,p in pairs(Players:GetPlayers()) do
                    if p~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (minhaPos - p.Character.HumanoidRootPart.Position).Magnitude
                        if dist <= AlcanceAura then
                            pcall(function() HRP().CFrame = p.Character.HumanoidRootPart.CFrame end)
                        end
                    end
                end
            end

            -- ✅ ARREMESSO INSTANTÂNEO / TELEPORTE / FALSO
