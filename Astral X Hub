	ln.ZIndex = 999
	ln.Parent = ScreenGui

	DadosJogadores[v] = {HL=hl, Nome=txtNome, Dist=txtDist, Linha=ln}
	
	-- ✅ FAZ O HIGHLIGHT SEGUIR QUANDO MORRER E NASCER DE NOVO
	v.CharacterAdded:Connect(function(novoChar)
		task.wait(0.1)
		if DadosJogadores[v] and hl then
			hl.Adornee = novoChar
		end
	end)
	
	return DadosJogadores[v]
end

local function AtualizarLinha(frm, origem, fim)
	local dist = (fim - origem).Magnitude
	local ang = math.deg(math.atan2(fim.Y - origem.Y, fim.X - origem.X)) - 90
	frm.Size = UDim2.new(0, 2, 0, dist)
	frm.Position = UDim2.new(0, origem.X, 0, origem.Y)
	frm.Rotation = ang
end

-- ===========================================
-- LOOP PRINCIPAL
-- ===========================================
RunService.Heartbeat:Connect(function()
	local me = player.Character
	if not me or not me:FindFirstChild("HumanoidRootPart") then return end
	local centroBaixo = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
	local Ativos = {}

	for _,alvo in pairs(Players:GetPlayers()) do
		if alvo == player then goto continua end
		local char = alvo.Character
		if not char then goto continua end
		local head = char:FindFirstChild("Head")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not head or not hrp then goto continua end

		local tipo, cor = PegarTipoJogador(alvo)
		if tipo == "Lobby" then goto continua end

		Ativos[alvo] = true
		local obj = CriarSeNaoExistir(alvo)
		local posC, visC = Camera:WorldToViewportPoint(head.Position)
		local posP, visP = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2.5,0))

		-- HIGHLIGHT
		obj.HL.Visible = ((tipo=="Assassino" and HighAss) or (tipo=="Xerife" and HighXer) or (tipo=="Inocente" and HighIno)) and visC or false
		if obj.HL.Visible then obj.HL.FillColor = cor obj.HL.OutlineColor = cor end

		-- NOME
		obj.Nome.Visible = ((tipo=="Assassino" and NomeAss) or (tipo=="Xerife" and NomeXer) or (tipo=="Inocente" and NomeIno)) and visC or false
		if obj.Nome.Visible then
			obj.Nome.Text = alvo.Name.." • "..tipo
			obj.Nome.TextColor3 = cor
			obj.Nome.Position = UDim2.new(0,posC.X,0,posC.Y-25)
		end

		-- DISTÂNCIA
		obj.Dist.Visible = ((tipo=="Assassino" and DistAss) or (tipo=="Xerife" and DistXer) or (tipo=="Inocente" and DistIno)) and visP or false
		if obj.Dist.Visible then
			local d = math.floor((me.HumanoidRootPart.Position - hrp.Position).Magnitude)
			obj.Dist.Text = d.."m"
			obj.Dist.TextColor3 = cor
			obj.Dist.Position = UDim2.new(0,posP.X,0,posP.Y+12)
		end

		-- LINHA
		obj.Linha.Visible = ((tipo=="Assassino" and LinhaAss) or (tipo=="Xerife" and LinhaXer) or (tipo=="Inocente" and LinhaIno)) and visC or false
		if obj.Linha.Visible then
			obj.Linha.BackgroundColor3 = cor
			AtualizarLinha(obj.Linha, centroBaixo, Vector2.new(posC.X, posC.Y))
		end

		::continua::
	end

	-- LIMPA SÓ QUEM SAIU DO JOGO
	for v,obj in pairs(DadosJogadores) do
		if not Ativos[v] then
			obj.HL:Destroy()
			obj.Nome:Destroy()
			obj.Dist:Destroy()
			obj.Linha:Destroy()
			DadosJogadores[v] = nil
		end
	end
end)

