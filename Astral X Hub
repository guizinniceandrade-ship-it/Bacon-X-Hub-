-- FUNÇÃO CORRIGIDA PARA BUSCAR SERVIDORES
local function BuscarServidor(minimoJogadores)
    local placeId = game.PlaceId
    local link = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=50", placeId)
    
    local sucesso, resposta = pcall(function()
        return HttpService:GetAsync(link, true)
    end)
    
    if not sucesso or not resposta then return nil end
    
    local dadosSucesso, dados = pcall(function()
        return HttpService:JSONDecode(resposta)
    end)
    
    if not dadosSucesso or not dados or not dados.data then return nil end
    
    for _, servidor in ipairs(dados.data) do
        if servidor.playing >= minimoJogadores and servidor.id ~= game.JobId then
            return servidor.id
        end
    end
    return nil
end

