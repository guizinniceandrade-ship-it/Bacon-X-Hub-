-- Pulo infinito
UIS.JumpRequest:Connect(function()
    if infJump and player.Character then
        local h = player.Character:FindFirstChild("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Movimento e Voo CORRIGIDO (agora no RenderStepped)
RunService.RenderStepped:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    -- ✅ PLATFORMSTAND CORRIGIDO: LIGA E DESLIGA CERTO
    hum.PlatformStand = fly
    hum.WalkSpeed = walkSpeed
    hum.JumpPower = jumpPower

    -- Noclip
    if noclip then
        for _,p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    else
        for _,p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end

    -- Movimento do Voo
    if fly then
        local dir = Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0,-1,0) end

        if dir.Magnitude > 0 then
            root.Velocity = dir.Unit * flySpeed
        else
            root.Velocity = Vector3.new()
        end
    end
end)

-- ESP OTIMIZADO
RunService.Heartbeat:Connect(function(Tempo)
    -- ✅ DETECÇÃO DE MAPA CORRETA: Usa PlaceId, não confunde com modelos
    if game.PlaceId ~= PlaceIdAtual then
        PlaceIdAtual = game.PlaceId
        Murder, Sheriff, Hero = nil, nil, nil
        listaCargos = nil
        TempoAtualizarDados = 0
    end

    -- ✅ ATUALIZA DADOS SÓ 1 VEZ A CADA 0.5 SEGUNDOS
    if not listaCargos or Tempo >= TempoAtualizarDados then
        TempoAtualizarDados = Tempo + 0.5
        local PegarDados = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if PegarDados then
            local ok, res = pcall(function() return PegarDados:InvokeServer() end)
            if ok and res then listaCargos = res end
        end
    end

    if not ESP_ATIVO or not listaCargos then
        for _,hl in pairs(HighlightCache) do if hl then hl.Enabled = false end end
        return
    end

    -- Define os papéis
    Murder, Sheriff, Hero = nil, nil, nil
    for Nome, Dados in pairs(listaCargos) do
        if Dados.Role == "Murderer" then Murder = Nome
        elseif Dados.Role == "Sheriff" then Sheriff = Nome
        elseif Dados.Role == "Hero" then Hero = Nome end
    end

    -- Aplica marcações
    for _,J in pairs(Players:GetPlayers()) do
        if J == player then continue end
        CriarBrilho(J)
        local hl = HighlightCache[J]
        if not hl then continue end

        -- Cores certas
        if J.Name == Murder and EstaVivo(J, listaCargos) then
            hl.FillColor = Color3.fromRGB(255, 40, 40)
            hl.OutlineColor = Color3.fromRGB(255, 80, 80)
        elseif J.Name == Sheriff and EstaVivo(J, listaCargos) then
            hl.FillColor = Color3.fromRGB(40, 120, 255)
            hl.OutlineColor = Color3.fromRGB(80, 150, 255)
        elseif J.Name == Hero and EstaVivo(J, listaCargos) and Sheriff and not EstaVivo(Players[Sheriff], listaCargos) then
            hl.FillColor = Color3.fromRGB(255, 215, 0)
            hl.OutlineColor = Color3.fromRGB(255, 230, 50)
        else
            hl.FillColor = Color3.fromRGB(50, 255, 50)
            hl.OutlineColor = Color3.fromRGB(80, 255, 80)
        end
        hl.Enabled = true
    end

    AtualizarArmas()
end)
