local RawMetatable = getrawmetatable(game)
local ChamadaOriginal = RawMetatable.__namecall
setreadonly(RawMetatable, false)

RawMetatable.__namecall = newcclosure(function(Objeto, ...)
    local Metodo = getnamecallmethod()
    local Args = {...}

    if SilentAimFacaAtivo and Metodo == "InvokeServer" and tostring(Objeto) == "ThrowKnife" then
