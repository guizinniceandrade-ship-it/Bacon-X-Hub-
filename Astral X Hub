-- ==========================
-- FUNÇÕES AUXILIARES CORRIGIDAS
-- ==========================
local HighlightCache = {}

local function CriarBrilho(Jogador)
    if not Jogador or not Jogador.Character then return end
    if HighlightCache[Jogador] then return end

    local hl = Instance.new("Highlight")
    hl.Name = "AstralX_Highlight"
    hl.Adornee = Jogador.Character
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.OutlineTransparency = 0
    hl.Enabled = false
    hl.Parent = Jogador.Character
    HighlightCache[Jogador] = hl

    -- Recria automaticamente quando renasce
    Jogador.CharacterAdded:Connect(function(novaChar)
        HighlightCache[Jogador] = nil
        task.wait(0.1)
        CriarBrilho(Jogador)
    end)
end

local function EstaVivo(Jogador, lista)
    if not lista or not lista[Jogador.Name] then return false end
    return not lista[Jogador.Name].Killed
end

local function AtualizarArmas()
    for _,Obj in pairs(workspace:GetDescendants()) do
        if Obj.Name == "GunDrop" and Obj:IsA("BasePart") then
            local hl = Obj:FindFirstChild("AstralX_Arma") or Instance.new("Highlight", Obj)
            hl.Name = "AstralX_Arma"
            hl.FillTransparency = 1
            hl.OutlineColor = Color3.fromRGB(255,255,0)
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Enabled = ESP_Arma
        end
    end
end

