-- =========================
-- FUNÇÕES DE TELEPORTE
-- =========================
local function HRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function GetMapa()
    for _,v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Spawns", true)
        and v.Name ~= "Lobby" and not string.find(v.Name:lower(),"lobby") then
            return v
        end
    end
end

local function GetLobby()
    for _,v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") then
            local n = v.Name:lower()
            if string.find(n,"lobby") then return v end
        end
    end
end

local function GetBasePart(model)
    if not model then return end
    return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function IrPartida()
    local mapa = GetMapa()
    if mapa then
        local spawn = mapa:FindFirstChild("Spawns", true) or mapa:FindFirstChild("PlayerSpawns", true)
        if spawn then HRP().CFrame = (spawn.PrimaryPart or spawn):WaitForChild("HumanoidRootPart").CFrame + Vector3.new(0,5,0) return end
        local part = GetBasePart(mapa)
        if part then HRP().CFrame = part.CFrame + Vector3.new(0,5,0) return end
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local r = plr.Character:FindFirstChild("HumanoidRootPart")
            if r then HRP().CFrame = r.CFrame + Vector3.new(0,5,3) return end
        end
    end
end

local function IrLobby()
    local lobby = GetLobby()
    if lobby then
        local p = GetBasePart(lobby)
        if p then HRP().CFrame = p.CFrame + Vector3.new(0,5,0) end
    end
end

