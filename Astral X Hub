local GunHook
GunHook = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() then
        if typeof(self) == "Instance" then
            if self.Name == "Shoot" and method == "FireServer" then
                if getgenv().SheriffAim and getgenv().GunAccuracy then
                    if Murder then
                        local Alvo = Players:FindFirstChild(tostring(Murder))
                        if not Alvo or not Alvo.Character then return GunHook(self, unpack(args)) end
                        local Root = Alvo.Character.PrimaryPart
                        if not Root then return GunHook(self, unpack(args)) end
                        
                        local Veloc = Root.AssemblyLinearVelocity or Vector3.zero
                        local Pos = Root.Position +
                            (Veloc * Vector3.new(
                                getgenv().GunAccuracy / 200,
                                0,
                                getgenv().GunAccuracy / 200
                            ))

                        if args[1] and typeof(args[1]) == "CFrame" then
                            args[1] = CFrame.new(Pos) * args[1].Rotation
                        end
                    end
                end
            end
        end
    end

    return GunHook(self, unpack(args))
end)

