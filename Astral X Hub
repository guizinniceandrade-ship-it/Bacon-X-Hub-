                Label.Text = "ARMA"
                Label.TextColor3 = Color3.fromRGB(255, 255, 0)
                Label.TextScaled = true
                Label.Font = Enum.Font.GothamBold
                Label.Parent = Texto
                MarcaArmas[obj] = {Destaque = Destaque, Texto = Texto}
