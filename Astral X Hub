                MarcaArmas[obj] = {Destaque=Destaque, Texto=Texto}
            end
            MarcaArmas[obj].Destaque.Enabled = true
            MarcaArmas[obj].Texto.Enabled = true
        end
        for obj,_ in pairs(MarcaArmas) do
            if not obj or not obj.Parent then MarcaArmas[obj] = nil end
        end
        task.wait(0.3)
