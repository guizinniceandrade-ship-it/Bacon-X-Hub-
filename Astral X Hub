-- SISTEMA DA HITBOX
RunService.Stepped:Connect(function()
    local c = player.Character
    if not c then return end
    local faca = c:FindFirstChild("Knife")
    if not faca then return end

    if HitboxAtivo then
        for _, p in ipairs(faca:GetChildren()) do
            if p:IsA("BasePart") then
                p.Size = Vector3.new(TamanhoHit, TamanhoHit, TamanhoHit)
                p.CanCollide = false
            end
        end
    else
        for _, p in ipairs(faca:GetChildren()) do
            if p:IsA("BasePart") then
                p.Size = Vector3.new(1.8, 1, 5.5)
            end
        end
    end
end)
