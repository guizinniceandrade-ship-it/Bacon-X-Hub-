-- =========================
-- ABA ESP
-- =========================
pcall(function()
    local MapaAtual = workspace:FindFirstChildWhichIsA("Model", true)
    if MapaAtual and MapaAtual ~= UltimoMapa then
        UltimoMapa = MapaAtual
        Limpar_ESP()
    end

    if not ESP_ATIVO then
        for _,J in pairs(Players:GetPlayers()) do
            if Destaques_Jogadores[J] then
                Destaques_Jogadores[J].Enabled = false
            end
        end
        Murder, Sheriff, Hero = nil, nil, nil
        return
    end

    local PegarDados = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not PegarDados then return end
    local listaCargos = PegarDados:InvokeServer()
    if not listaCargos then return end

    -- Primeiro define quem é cada cargo
    Murder, Sheriff, Hero = nil, nil, nil
    for Nome, DadosJogador in pairs(listaCargos) do
        if DadosJogador.Role == "Murderer" then
            Murder = Nome
        elseif DadosJogador.Role == "Sheriff" then
            Sheriff = Nome
        elseif DadosJogador.Role == "Hero" then
            Hero = Nome
        end
    end

    -- Depois marca os jogadores
    for _,J in pairs(Players:GetPlayers()) do
        if J == player then continue end
        if not J.Character then
            if Destaques_Jogadores[J] then
                Destaques_Jogadores[J].Enabled = false
            end
            continue
        end

        Criar_Destaque_Jogador(J)
        local hl = Destaques_Jogadores[J]
        local Cor = Color3.fromRGB(80,255,80)
        local Mostrar = false

        if J.Name == Murder and Esta_Vivo(J, listaCargos) and ESP_Murderer then
            Cor = Color3.fromRGB(255,40,40)
            Mostrar = true
        elseif J.Name == Sheriff and Esta_Vivo(J, listaCargos) and ESP_Xerife then
            Cor = Color3.fromRGB(40,140,255)
            Mostrar = true
        elseif J.Name == Hero and Esta_Vivo(J, listaCargos) and ESP_Heroi then
            Cor = Color3.fromRGB(255,210,0)
            Mostrar = true
        elseif ESP_Inocente and Esta_Vivo(J, listaCargos) then
            Mostrar = true
        end

        hl.Enabled = Mostrar
        hl.FillColor = Cor
        hl.OutlineColor = Cor
    end

    -- Marca armas
    if ESP_Arma then
        for _,Obj in pairs(workspace:GetChildren()) do
            if Obj.Name == "GunDrop" and Obj:IsA("BasePart") then
                Criar_Destaque_Arma(Obj)
                local hl = Destaques_Armas[Obj]
                hl.Enabled = true
                hl.FillColor = Color3.fromRGB(255,255,0)
                hl.OutlineColor = Color3.fromRGB(255,255,0)
            else
                if Destaques_Armas[Obj] then
                    Destaques_Armas[Obj].Enabled = false
                end
            end
        end
    end
end)

