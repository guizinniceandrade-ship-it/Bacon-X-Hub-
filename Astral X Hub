-- ✅ HOOK CORRIGIDO SEGURO — EXATAMENTE COMO EXPLICOU
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and method == "FireServer" and self.Name == "Shoot" then
        if getgenv().SheriffAim and Murder then
            local Alvo = Players[tostring(Murder)]
            if Alvo and Alvo.Character then
                local Root = Alvo.Character:FindFirstChild("HumanoidRootPart") or Alvo.Character.PrimaryPart
                if Root then
                    local Veloc = Root.AssemblyLinearVelocity
                    local Previsao = getgenv().GunAccuracy / 200
                    local Pos = Root.Position + Vector3.new(Veloc.X * Previsao, 0, Veloc.Z * Previsao)

                    if typeof(args[1]) == "CFrame" then
                        args[1] = CFrame.new(Pos) * args[1].Rotation
                    end
                end
            end
        end
    end

    return oldNamecall(self, unpack(args))
end)

