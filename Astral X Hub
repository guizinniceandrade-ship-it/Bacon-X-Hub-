-- ===========================================
-- AUTO FARM COM TODAS AS VERIFICAÇÕES
-- ===========================================
local function EmPartida()
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            return true
        end
    end
    return false
end

local function QuantidadeMochila()
    local ok, n = pcall(function()
        local g = player:WaitForChild("PlayerGui"):WaitForChild("MainGUI", 2)
        return tonumber(g.Game.CoinBags.Container.SnowToken.CurrencyFrame.Icon.Coins.Text) or 0
    end)
    return ok and n or 0
end

local function MoedaValida(moeda)
    return moeda and moeda.Parent 
    and moeda:IsA("BasePart")
    and moeda:FindFirstChild("TouchInterest")
    and moeda:FindFirstChild("CoinVisual")
    and not moeda:GetAttribute("Collected")
end

local function getNearestCoin(minhaPos)
    local melhorMoeda = nil
    local menorDist = math.huge
    local CoinContainer = Workspace:FindFirstChild("CoinContainer", true)
    if not CoinContainer then return nil end

    for _, v in ipairs(CoinContainer:GetChildren()) do  
        if v:IsA("BasePart")  
        and v.Name == "Coin_Server"  
        and v:FindFirstChild("TouchInterest")  
        and v:FindFirstChild("CoinVisual")  
        and not collectedCoins[v]  
        and not v:GetAttribute("Collected") then  

            local dist = (minhaPos - v.Position).Magnitude  
            if dist < CONFIG_FARM.alcance_maximo and dist < menorDist then  
                menorDist = dist  
                melhorMoeda = v  
            end  
        end  
    end  
    return melhorMoeda
end

task.spawn(function()
    while true do
        if AutoFarmAtivo then
            if not EmPartida() then
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
                continue
            end

            local atual = QuantidadeMochila()
            if atual >= CONFIG_FARM.limite then
                repeat
                    RunService.Heartbeat:Wait()
                    atual = QuantidadeMochila()
                until atual < CONFIG_FARM.limite or not AutoFarmAtivo or not EmPartida()
                table.clear(collectedCoins)
                continue
            end

            local c = player.Character
            if not c or not c.PrimaryPart then RunService.Heartbeat:Wait() continue end

            local minhaPos = c.PrimaryPart.Position
            local alvo = getNearestCoin(minhaPos)

            if alvo then
                local ini = minhaPos
                local destino = alvo.Position
                local distTotal = (ini - destino).Magnitude
                local tempo = distTotal / CONFIG_FARM.velocidade
                local tIni = os.clock()

                while AutoFarmAtivo and EmPartida() and MoedaValida(alvo) and QuantidadeMochila() < CONFIG_FARM.limite do
                    local char = player.Character
                    if not char or not char.PrimaryPart then break end

                    local novaPos = char.PrimaryPart.Position
                    local novoAlvo = getNearestCoin(novaPos)
                    if novoAlvo and novoAlvo ~= alvo then
                        alvo = novoAlvo
                        ini = novaPos
                        destino = alvo.Position
                        distTotal = (ini - destino).Magnitude
                        tempo = distTotal / CONFIG_FARM.velocidade
                        tIni = os.clock()
                    end

                    local progresso = math.min((os.clock() - tIni) / tempo, 1)
                    char:PivotTo(CFrame.new(ini:Lerp(destino, progresso)))

                    if not MoedaValida(alvo) then break end
                    if progresso >= 1 then break end

                    RunService.Heartbeat:Wait()
                end

                if alvo then collectedCoins[alvo] = true end
            else
                table.clear(collectedCoins)
                RunService.Heartbeat:Wait()
            end
        end
        RunService.Heartbeat:Wait()
    end
end)

