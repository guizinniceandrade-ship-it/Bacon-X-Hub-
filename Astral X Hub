-- ==========================
-- FUNÇÕES DO ESP
-- ==========================
local function CriarBrilho(Jogador)
    if not Jogador or not Jogador.Character then return end
    if not Jogador.Character:FindFirstChild("Highlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "Highlight"
        hl.Adornee = Jogador.Character
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.OutlineTransparency = 0
        hl.Enabled = false
        hl.Parent = Jogador.Character
    end
end

local function EstaVivo(Jogador, listaCargos)
    if not listaCargos or not listaCargos[Jogador.Name] then return false end
    local Info = listaCargos[Jogador.Name]
    return not Info.Killed and not Info.Dead
end

local function AtualizarArmas()
    for _,Obj in pairs(workspace:GetDescendants()) do
        if Obj.Name == "GunDrop" and Obj:IsA("BasePart") then
            if ESP_Arma then
                if not Obj:FindFirstChild("MarcaArma") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "MarcaArma"
                    hl.FillTransparency = 1
                    hl.OutlineColor = Color3.fromRGB(255,255,0)
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = Obj
                end
                Obj.MarcaArma.Enabled = true
            else
                if Obj:FindFirstChild("MarcaArma") then
                    Obj.MarcaArma.Enabled = false
                end
            end
        end
    end
end

-- ==========================
-- FUNÇÕES DE TELEPORTE
-- ==========================
local function IrParaLobby()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local Lobby = workspace:FindFirstChild("Lobby", true)
    if Lobby then
        local Alvo = Lobby:IsA("Model") and (Lobby.PrimaryPart or Lobby:FindFirstChildWhichIsA("BasePart")) or Lobby
        if Alvo and Alvo:IsA("BasePart") then
            root.CFrame = Alvo.CFrame + Vector3.new(0, 3, 0)
        end
    end
end

local function IrParaSpawn()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local Spawn = workspace:FindFirstChild("Spawn", true)
    if Spawn and Spawn:IsA("BasePart") then
        root.CFrame = Spawn.CFrame + Vector3.new(0, 3, 0)
    end
end

-- ==========================
-- SISTEMA GERAL DE MOVIMENTO E ESP
-- ==========================
UIS.JumpRequest:Connect(function()
    if infJump and player.Character then
        local hum = player.Character:FindFirstChild("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

UIS.InputChanged:Connect(function(entrada, processado)
    if processado or not fly then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    local dir = Vector3.new()
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += workspace.CurrentCamera.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= workspace.CurrentCamera.CFrame.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= workspace.CurrentCamera.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += workspace.CurrentCamera.CFrame.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir += Vector3.new(0,-1,0) end

    if dir.Magnitude > 0 then dir = dir.Unit end
    root.Velocity = dir * flySpeed
    hum.PlatformStand = true
end)

RunService.Stepped:Connect(function()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end

    hum.WalkSpeed = walkSpeed
    hum.JumpPower = jumpPower

    if noclip then
        for _,p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    else
        for _,p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end

    if fly then
        hum.PlatformStand = true
    end

    -- ==========================================
    -- ATUALIZAÇÃO DO ESP
    -- ==========================================
    pcall(function()
        local MapaAtual = workspace:FindFirstChildWhichIsA("Model", true)
        if MapaAtual and MapaAtual ~= UltimoMapa then
            UltimoMapa = MapaAtual
            Murder, Sheriff, Hero = nil, nil, nil
        end

        if not ESP_ATIVO then
            for _,J in pairs(Players:GetPlayers()) do
                if J.Character and J.Character:FindFirstChild("Highlight") then
                    J.Character.Highlight.Enabled = false
                end
            end
            Murder, Sheriff, Hero = nil, nil, nil
        else
            local PegarDados = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if not PegarDados then return end
            local listaCargos = PegarDados:InvokeServer()
            if not listaCargos then return end

            Murder, Sheriff, Hero = nil, nil, nil
            for Nome, DadosJogador in pairs(listaCargos) do
                if DadosJogador.Role == "Murderer" then Murder = Nome
                elseif DadosJogador.Role == "Sheriff" then Sheriff = Nome
                elseif DadosJogador.Role == "Hero" then Hero = Nome end
            end

            for _,J in pairs(Players:GetPlayers()) do
                if J == player then continue end
                CriarBrilho(J)
                local hl = J.Character:FindFirstChild("Highlight")
                if not hl then continue end

                if J.Name == Murder and EstaVivo(J, listaCargos) then
                    hl.FillColor = Color3.fromRGB(255, 40, 40)
                    hl.OutlineColor = Color3.fromRGB(255, 80, 80)
                elseif J.Name == Sheriff and EstaVivo(J, listaCargos) then
                    hl.FillColor = Color3.fromRGB(40, 120, 255)
                    hl.OutlineColor = Color3.fromRGB(80, 150, 255)
                elseif J.Name == Hero and EstaVivo(J, listaCargos) and Sheriff and not EstaVivo(Players[Sheriff], listaCargos) then
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 230, 50)
                else
                    hl.FillColor = Color3.fromRGB(50, 255, 50)
                    hl.OutlineColor = Color3.fromRGB(80, 255, 80)
                end

                hl.Enabled = true
            end
        end

        AtualizarArmas()
    end)
end)

