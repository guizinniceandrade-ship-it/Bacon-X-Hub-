                -- Detecta quando você usa a faca
                player.Character.Humanoid.Activated:Connect(function()
                    local alvo, dist = nil, math.huge
                    for _,p in pairs(Players:GetPlayers()) do
                        if p~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (minhaPos - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist=d alvo=p end
                        end
                    end
                    if not alvo or not alvo.Character then return end

                    -- Se for arremesso falso: só faz a animação, não acerta
                    if ArremessoFalso then return end

                    -- Se for arremesso rápido/teleporte
                    if TeleporteComFaca then
                        HRP().CFrame = alvo.Character.HumanoidRootPart.CFrame
                    end
                end)
            end
        end
