-- DETECÇÃO DE CARGOS MAIS COMPLETA
-- ===========================================
local function PegarTipoJogador(v)
    local tipoFinal = "Lobby"
    local corFinal = Color3.fromRGB(200,200,200)
    pcall(function()
        local char = v.Character
        if not char then return end
        local backpack = v:FindFirstChildOfClass("Backpack")
        
        -- Procura faca em TODOS os lugares possíveis
        local temFaca = char:FindFirstChild("Knife") or char:FindFirstChild("Weapon") or (backpack and backpack:FindFirstChildWhichIsA("Tool") and string.find(string.lower(backpack:FindFirstChildWhichIsA("Tool").Name), "knife"))
        -- Procura arma de xerife
        local temArma = char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or (backpack and backpack:FindFirstChildWhichIsA("Tool") and string.find(string.lower(backpack:FindFirstChildWhichIsA("Tool").Name), "gun"))

        if temFaca then
            tipoFinal, corFinal = "Assassino", Color3.fromRGB(255,50,50)
        elseif temArma then
            tipoFinal, corFinal = "Xerife", Color3.fromRGB(50,120,255)
        else
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                tipoFinal, corFinal = "Inocente", Color3.fromRGB(50,255,80)
            end
        end
    end)
    return tipoFinal, corFinal
end

