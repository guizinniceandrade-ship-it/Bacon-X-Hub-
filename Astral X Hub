    while true do
        if player.Name == Sheriff then
            -- Auto tiro
            if AutoAtirar then AtirarNoMurderer() end
            -- Auto pegar arma
            if AutoPegarArma then PegarArma() end
        end
        RunService.Heartbeat:Wait()
    end
end)

-- ðŸ–±ï¸ FAZER BOTÃƒO FLUTUANTE ARRASTAR E CLICAR
local Arrastando, InicioPos, InicioMouse
FloatingButton.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        Arrastando = true
        InicioPos = FloatingButton.Position
        InicioMouse = i.Position
    end
end)
UIS.InputChanged:Connect(function(i)
    if Arrastando and i.UserInputType == Enum.UserInputType.MouseMovement then
        local Delta = i.Position - InicioMouse
        FloatingButton.Position = UDim2.new(
            InicioPos.X.Scale, InicioPos.X.Offset + Delta.X,
            InicioPos.Y.Scale, InicioPos.Y.Offset + Delta.Y
        )
    end
end)
UIS.InputEnded:Connect(function() Arrastando = false end)
FloatingButton.MouseButton1Click:Connect(AtirarNoMurderer)

