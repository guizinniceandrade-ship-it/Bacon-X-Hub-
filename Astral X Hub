-- ðŸ” LOOP PRINCIPAL - COLOQUE NO FINAL DO SEU SCRIPT
task.spawn(function()
    while true do
        -- SÃ“ FUNCIONA SE VOCÃŠ FOR O ASSASSINO
        if player.Name == Murder and player.Character then
            local minhaPos = HRP().Position

            -- âœ… AURA DE MATAR
            if KillAuraAtivo then
                for _,p in pairs(Players:GetPlayers()) do
                    if p~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = (minhaPos - p.Character.HumanoidRootPart.Position).Magnitude
                        if dist <= AlcanceAura then
                            pcall(function() HRP().CFrame = p.Character.HumanoidRootPart.CFrame end)
                        end
                    end
                end
            end

            -- âœ… ARREMESSO INSTANTÃ‚NEO / TELEPORTE / FALSO
            if FacaInstantanea or TeleporteComFaca or ArremessoFalso then
                -- Detecta quando vocÃª usa a faca
                player.Character.Humanoid.Activated:Connect(function()
                    local alvo, dist = nil, math.huge
                    for _,p in pairs(Players:GetPlayers()) do
                        if p~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (minhaPos - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist=d alvo=p end
                        end
                    end
                    if not alvo or not alvo.Character then return end

                    -- Se for arremesso falso: sÃ³ faz a animaÃ§Ã£o, nÃ£o acerta
                    if ArremessoFalso then return end

                    -- Se for arremesso rÃ¡pido/teleporte
                    if TeleporteComFaca then
                        HRP().CFrame = alvo.Character.HumanoidRootPart.CFrame
                    end
                end)
            end
        end
        RunService.Heartbeat:Wait()
    end
end)

