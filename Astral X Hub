-- PULO INFINITO
local function ConfigurarInfiniteJump(character)
	local humanoid = character:WaitForChild("Humanoid")
	HumanoidAtual = humanoid
	humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
		if PuloInfinitoAtivo and humanoid.Jump then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
end

if player.Character then ConfigurarInfiniteJump(player.Character) end
player.CharacterAdded:Connect(ConfigurarInfiniteJump)

-- NOCLIP + LOOP PRINCIPAL DO PERSONAGEM
RunService.Heartbeat:Connect(function()
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	hum.UseJumpPower = false
	hum.WalkSpeed = VelocidadeSalva
	hum.JumpHeight = ForcaPuloSalva

	if NoclipAtivo then
		for _, Parte in pairs(char:GetDescendants()) do
			if Parte:IsA("BasePart") and Parte.CanCollide then
				Parte.CanCollide = false
			end
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		task.wait(0.3)
		hum.UseJumpPower = false
		hum.WalkSpeed = VelocidadeSalva
		hum.JumpHeight = ForcaPuloSalva
		task.delay(0.6, function()
			if hum then
				hum.UseJumpPower = false
				hum.WalkSpeed = VelocidadeSalva
				hum.JumpHeight = ForcaPuloSalva
			end
		end)
	end
end)

