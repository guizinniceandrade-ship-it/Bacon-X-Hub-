-- 🎯 FUNÇÃO PRINCIPAL DE TIRO
function AtirarNoMurderer()
    if player.Name ~= Sheriff then return end
    local Alvo = Players:FindFirstChild(Murder)
    if not Alvo or not Alvo.Character then return end
    local AlvoHRP = Alvo.Character:FindFirstChild("HumanoidRootPart")
    local EuHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not AlvoHRP or not EuHRP then return end

    -- Calcula posição futura
    local PosicaoAjustada = AlvoHRP.Position + (AlvoHRP.Velocity * PrevisaoTiro)

    -- Mira invisível: não mexe a câmera
    if not MiraOculta then
        workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.Position, PosicaoAjustada)
    end

    -- Atira
    task.wait(0.02)
    pcall(function() player.Character.Humanoid:Activate() end)
end

-- 🧲 AUTO PEGAR ARMA IGUAL KOMATHUB (VAI E VOLTA)
local function PegarArma()
    if Teleportando then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local arma = nil
    for _,v in pairs(workspace:GetDescendants()) do
        if v.Name == "GunDrop" and v:IsA("BasePart") then
            arma = v
            break
        end
    end
    if not arma then return end

    Teleportando = true
    local LugarOriginal = root.CFrame -- ✅ GUARDA SEU LUGAR
    root.CFrame = arma.CFrame + Vector3.new(0,2,0) -- ✅ VAI NA ARMA
    task.wait(0.4) -- ✅ TEMPO DE PEGAR
    if root then root.CFrame = LugarOriginal end -- ✅ VOLTA PRO SEU LUGAR
    task.wait(0.3)
    Teleportando = false
end

