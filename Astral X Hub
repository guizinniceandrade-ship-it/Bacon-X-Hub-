-- PEGA OS CARGOS DO JOGO
-- ===========================================
task.spawn(function()
    while true do
        if ESP_ATIVO then
            local PegarDados = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if PegarDados then
                local ok, res = pcall(function() return PegarDados:InvokeServer() end)
                if ok and type(res) == "table" then
                    local novoMurder, novoSheriff, novoHero = nil, nil, nil
                    for Nome,DadosJogador in pairs(res) do
                        if DadosJogador.Role == "Murderer" then novoMurder = Nome
                        elseif DadosJogador.Role == "Sheriff" then novoSheriff = Nome
                        elseif DadosJogador.Role == "Hero" then novoHero = Nome end
                    end
                    if novoMurder then Murder = novoMurder end
                    if novoSheriff then Sheriff = novoSheriff end
                    if novoHero then Hero = novoHero end
                    UltimoCargos = res
                end
            end
        end
        task.wait(0.3)
    end
end)

-- ===========================================
-- SISTEMA PRINCIPAL DO HIGHLIGHT
-- ===========================================
task.spawn(function()
    while true do
        if not ESP_ATIVO then
            for _,J in pairs(Players:GetPlayers()) do
                if J.Character and J.Character:FindFirstChild("Highlight") then
                    J.Character.Highlight.Enabled = false
                end
            end
        else
            for _,J in pairs(Players:GetPlayers()) do
                if J == player or not J.Character then continue end
                CriarBrilho(J)
                local hl = J.Character:FindFirstChild("Highlight")
                if not hl then continue end

                local XerifeMorto = Sheriff and Players:FindFirstChild(Sheriff) and not EstaVivo(Players[Sheriff], UltimoCargos) or false

                if J.Name == Murder and EstaVivo(J, UltimoCargos) then
                    hl.FillColor = Color3.fromRGB(255, 40, 40)
                    hl.Enabled = ESP_Murderer
                elseif J.Name == Sheriff and EstaVivo(J, UltimoCargos) then
                    hl.FillColor = Color3.fromRGB(40, 120, 255)
                    hl.Enabled = ESP_Xerife
                elseif J.Name == Hero and EstaVivo(J, UltimoCargos) and XerifeMorto then
                    hl.FillColor = Color3.fromRGB(255, 215, 0)
                    hl.Enabled = ESP_Xerife
                else
                    hl.FillColor = Color3.fromRGB(50, 255, 50)
                    hl.Enabled = ESP_Inocente
                end
                hl.OutlineColor = hl.FillColor
            end
        end
        task.wait(0.15)
    end
end)

