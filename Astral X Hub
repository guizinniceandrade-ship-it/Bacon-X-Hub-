            if Nome ~= "GunDrop" then continue end
            if Caminho:find("lobby") or Caminho:find("weapondisplays") or Caminho:find("prompt") then continue end
            local TemPessoa = obj:FindFirstAncestorWhichIsA("Model")
            if TemPessoa and TemPessoa:FindFirstChildOfClass("Humanoid") then continue end
            if obj:FindFirstAncestorWhichIsA("Backpack") then continue end
            local Parte = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if not Parte then continue end
            if not MarcaArmas[obj] then
                local Destaque = Instance.new("Highlight")
                Destaque.Name = "GunDrop_ESP"
                Destaque.Adornee = obj
                Destaque.FillTransparency = 1
                Destaque.OutlineTransparency = 0
                Destaque.OutlineColor = Color3.fromRGB(255, 255, 0)
                Destaque.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                Destaque.Parent = game.CoreGui
                local Texto = Instance.new("BillboardGui")
                Texto.Adornee = Parte
                Texto.Size = UDim2.new(0, 65, 0, 22)
                Texto.StudsOffset = Vector3.new(0, 2.2, 0)
                Texto.AlwaysOnTop = true
                Texto.Parent = Parte
                local Label = Instance.new("TextLabel")
                Label.Size = UDim2.fromScale(1, 1)
