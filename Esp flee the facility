local function CriarToggleDeslizante(pai, posY, texto)
    local Botao = Instance.new("TextButton", pai)
    Botao.Size = UDim2.new(1, -30, 0, 36)
    Botao.Position = UDim2.new(0, 15, 0, posY)
    Botao.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
    Botao.Text = "   " .. texto
    Botao.TextColor3 = Color3.fromRGB(200, 200, 200)
    Botao.Font = Enum.Font.GothamBold
    Botao.TextSize = 12
    Botao.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", Botao).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", Botao)
    stroke.Color = Color3.fromRGB(45, 45, 45)
    stroke.Thickness = 1.5

    local SwitchFundo = Instance.new("Frame", Botao)
    SwitchFundo.Size = UDim2.new(0, 42, 0, 22)
    SwitchFundo.Position = UDim2.new(1, -48, 0.5, -11)
    SwitchFundo.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Instance.new("UICorner", SwitchFundo).CornerRadius = UDim.new(1, 0)

    local Bolinha = Instance.new("Frame", SwitchFundo)
    Bolinha.Size = UDim2.new(0, 18, 0, 18)
    Bolinha.Position = UDim2.new(0, 2, 0.5, -9)
    Bolinha.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Instance.new("UICorner", Bolinha).CornerRadius = UDim.new(1, 0)

    local ligado = false
    local atualizarVisual = function() end

    Botao.MouseButton1Click:Connect(function()
        ligado = not ligado
        atualizarVisual()
    end)

    atualizarVisual = function()
        local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        if ligado then
            TweenService:Create(SwitchFundo, info, {BackgroundColor3 = Color3.fromRGB(50, 255, 50)}):Play()
            TweenService:Create(Bolinha, info, {Position = UDim2.new(1, -20, 0.5, -9), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            stroke.Color = Color3.fromRGB(50, 255, 50)
            Botao.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            TweenService:Create(SwitchFundo, info, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
            TweenService:Create(Bolinha, info, {Position = UDim2.new(0, 2, 0.5, -9), BackgroundColor3 = Color3.fromRGB(200, 200, 200)}):Play()
            stroke.Color = Color3.fromRGB(45, 45, 45)
            Botao.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end

    return Botao, function() return ligado end, function(estado) ligado = estado atualizarVisual() end
end

