local Tabs = {}

local function CreateTab(tabName)
    local tabBtn = Instance.new("TextButton", TabBar)
    tabBtn.Name = tabName .. "Tab"
    tabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    tabBtn.Size = UDim2.new(1, 0, 0, 35)
    tabBtn.Font = Enum.Font.FredokaOne
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(180, 180, 200)
    tabBtn.TextSize = 13

    local tabCorner = Instance.new("UICorner", tabBtn)
    tabCorner.CornerRadius = UDim.new(0, 6)

    local container = Instance.new("ScrollingFrame", ContentArea)
    container.Name = tabName .. "Container"
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, 0, 1, 0)
    container.Visible = false
    container.ScrollBarThickness = 4
    container.CanvasSize = UDim2.new(0, 0, 1.5, 0)

    local containerList = Instance.new("UIListLayout", container)
    containerList.SortOrder = Enum.SortOrder.LayoutOrder
    containerList.Padding = UDim.new(0, 8)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
            t.Btn.TextColor3 = Color3.fromRGB(180, 180, 200)
            t.Page.Visible = false
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(120, 60, 255)
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        container.Visible = true
    end)

    Tabs[tabName] = {Btn = tabBtn, Page = container}
    return container
end

local function CreateToggle(parentPage, text, configKey)
    local btn = Instance.new("TextButton", parentPage)
    btn.Name = configKey .. "Toggle"
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    btn.Size = UDim2.new(0.96, 0, 0, 36)
    btn.Font = Enum.Font.FredokaOne
    btn.Text = text .. " [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 80, 80)
    btn.TextSize = 13

    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(50, 50, 70)

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            btn.Text = text .. " [ ON ]"
            btn.TextColor3 = Color3.fromRGB(80, 255, 140)
            btn.BackgroundColor3 = Color3.fromRGB(30, 50, 40)
            btnStroke.Color = Color3.fromRGB(80, 255, 140)
        else
            btn.Text = text .. " [ OFF ]"
            btn.TextColor3 = Color3.fromRGB(255, 80, 80)
            btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
            btnStroke.Color = Color3.fromRGB(50, 50, 70)
        end
    end)
end

local function CreateSlider(parentPage, text, minVal, maxVal, configKey)
    local sliderFrame = Instance.new("Frame", parentPage)
    sliderFrame.Name = configKey .. "Frame"
    sliderFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    sliderFrame.Size = UDim2.new(0.96, 0, 0, 50)

    local sliderCorner = Instance.new("UICorner", sliderFrame)
    sliderCorner.CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel", sliderFrame)
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.04, 0, 0.1, 0)
    label.Size = UDim2.new(0.92, 0, 0, 18)
    label.Font = Enum.Font.FredokaOne
    label.Text = text .. ": " .. tostring(Config[configKey])
    label.TextColor3 = Color3.fromRGB(200, 200, 220)
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", sliderFrame)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    track.Position = UDim2.new(0.04, 0, 0.6, 0)
    track.Size = UDim2.new(0.92, 0, 0, 10)

    local trackCorner = Instance.new("UICorner", track)
    trackCorner.CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.BackgroundColor3 = Color3.fromRGB(120, 60, 255)
    fill.Size = UDim2.new((Config[configKey] - minVal) / (maxVal - minVal), 0, 1, 0)

    local fillCorner = Instance.new("UICorner", fill)
    fillCorner.CornerRadius = UDim.new(1, 0)

    local isDragging = false

    local function UpdateSlider(input)
        local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = math.floor(minVal + (maxVal - minVal) * pos)
        Config[configKey] = value
        fill.Size = UDim2.new(pos, 0, 1, 0)
        label.Text = text .. ": " .. tostring(value)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            UpdateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType.Touch then
            isDragging = false
        end
    end)
end

