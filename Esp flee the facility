-- ===========================================
-- LÓGICA DO AUTO FARM (PAUSA EM 40 SEM SUMIR COM O VISUAL)
-- ===========================================
local rt = {}
rt.walkspeed = 24
rt.limite = 40
local moedasPegas = {}

local function QuantidadeMochila()
    local ok, n = pcall(function()
        local g = player.PlayerGui:WaitForChild("MainGUI", 3)
        return tonumber(g.Game.CoinBags.Container.SnowToken.CurrencyFrame.Icon.Coins.Text) or 0
    end)
    return ok and n or 0
end

task.spawn(function()
    while Gui.Parent do
        if GetAutoFarm() then
            if QuantidadeMochila() >= rt.limite then
                task.wait(1)
            else
                local container = nil
                repeat
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if v.Name == "CoinContainer" then container = v break end
                    end
                    if not container then task.wait(0.5) end
                until container or not GetAutoFarm()

                if container and GetAutoFarm() then
                    table.clear(moedasPegas)

                    while GetAutoFarm() do
                        if QuantidadeMochila() >= rt.limite then
                            break
                        end

                        local c = player.Character
                        if not c or not c.PrimaryPart then task.wait(0.5) continue end

                        local melhorMoeda = nil
                        local menorDistancia = math.huge
                        local minhaPos = c.PrimaryPart.Position

                        for _, v in pairs(container:GetDescendants()) do
                            if v:IsA("TouchTransmitter") then
                                local m = v.Parent
                                if m and m:IsA("BasePart") and m.Parent and not moedasPegas[m] then
                                    local dist = (minhaPos - m.Position).Magnitude
                                    if dist < menorDistancia then
                                        menorDistancia = dist
                                        melhorMoeda = m
                                    end
                                end
                            end
                        end

                        if melhorMoeda then
                            moedasPegas[melhorMoeda] = true
                            
                            local ini = c.PrimaryPart.Position
                            local destino = melhorMoeda.Position
                            local distTotal = (ini - destino).Magnitude
                            local tempo = distTotal / rt.walkspeed
                            local tIni = os.clock()

                            while GetAutoFarm() and c and c.PrimaryPart and melhorMoeda.Parent and melhorMoeda:FindFirstChildOfClass("TouchTransmitter") do
                                if QuantidadeMochila() >= rt.limite then break end

                                local posAtual = c.PrimaryPart.Position
                                local novaMelhor = nil
                                local novaMenorDist = (posAtual - destino).Magnitude

                                for _, v in pairs(container:GetDescendants()) do
                                    if v:IsA("TouchTransmitter") then
                                        local m = v.Parent
                                        if m and m:IsA("BasePart") and m.Parent and not moedasPegas[m] then
                                            local d = (posAtual - m.Position).Magnitude
                                            if d < novaMenorDist then
                                                novaMenorDist = d
                                                novaMelhor = m
                                            end
                                        end
                                    end
                                end

                                if novaMelhor then
                                    moedasPegas[novaMelhor] = true
                                    break
                                end

                                local progresso = math.min((os.clock() - tIni) / tempo, 1)
                                c:PivotTo(CFrame.new(ini:Lerp(destino, progresso)))
                                if progresso >= 1 then break end
                                task.wait()
                            end
                        else
                            table.clear(moedasPegas)
                            task.wait(0.3)
                        end
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

task.spawn(function()
    while Gui.Parent do
