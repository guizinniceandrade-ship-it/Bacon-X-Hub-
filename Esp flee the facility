-- Pegar Ping
task.spawn(function()
    while Gui.Parent do
        pcall(function()
            local network = Stats:FindFirstChild("Network")
            if network and network:FindFirstChild("ServerStatsItem") then
                local pingItem = network.ServerStatsItem:FindFirstChild("Data Ping")
                if pingItem then PingVal = math.floor(pingItem:GetValue()) end
            end
            if (not PingVal or PingVal == 0) and Stats.NetworkStats and Stats.NetworkStats.ServerPing then
                PingVal = math.floor(Stats.NetworkStats.ServerPing)
            end
        end)
        task.wait(1)
    end
end)

-- Atualizar Status na Tela
RunService.Heartbeat:Connect(function()
    local Passado = os.time() - TempoInicio
    local H = math.floor(Passado / 3600)
    local M = math.floor((Passado % 3600) / 60)
    local S = Passado % 60
    ValPing.Text = tostring(PingVal) .. "ms"
    ValFPS.Text = tostring(FPS)
    ValTempo.Text = H > 0 and string.format("%02d:%02d:%02d", H, M, S) or string.format("%02d:%02d", M, S)
end)

