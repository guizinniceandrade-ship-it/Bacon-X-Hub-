local function MudarAba(abaAtiva)
    ContainerStats.Visible = (abaAtiva == 1)
    ContainerFuncoes.Visible = (abaAtiva == 2)
    ContainerPlayer.Visible = (abaAtiva == 3)
    ContainerEsp.Visible = (abaAtiva == 4)
    local abas = { {AbaStatsBtn, 1}, {AbaFuncoesBtn, 2}, {AbaPlayerBtn, 3}, {AbaEspBtn, 4} }
    for _, info in ipairs(abas) do
        local btn = info[1]
        local idx = info[2]
        btn.BackgroundColor3 = (abaAtiva == idx) and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(18, 18, 18)
        btn.TextColor3 = (abaAtiva == idx) and Color3.new(1, 1, 1) or Color3.fromRGB(150, 150, 150)
    end
end
